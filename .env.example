# =============================================================================
# BrevioAI — plantilla PRODUCCIÓN
# Copiar a `.env` y rellenar secretos reales.
# Catálogo: docs/ENVIRONMENT.md
#
#   docker compose -f docker-compose.yml up -d --build
#
# Desarrollo: copiar `.env.dev.example` → `.env.dev`
# Frontend Vite prod: frontend/.env.example → frontend/.env
# =============================================================================

PYTHONUNBUFFERED=1
PYTHONPATH=/app
LOG_LEVEL=INFO

FRONTEND_PORT=10010
BACKEND_PORT=10011
MONGO_PORT=27017
REDIS_PORT=6380

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT
MONGO_INITDB_DATABASE=brevio
MONGODB_URI=mongodb://root:CHANGE_ME_MONGO_ROOT@database:27017/brevio?authSource=admin
DATABASE_URL=mongodb://root:CHANGE_ME_MONGO_ROOT@database:27017/brevio?authSource=admin

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
EVENTS_REDIS_URL=redis://redis:6379/0
PROVIDER_QUOTA_REDIS_URL=redis://redis:6379/2
ANTI_ABUSE_REDIS_URL=redis://redis:6379/2
CAPACITY_REDIS_URL=redis://redis:6379/2
JOB_HEARTBEAT_REDIS_URL=redis://redis:6379/2
REDIS_USERNAME=brevio
REDIS_PASSWORD=CHANGE_ME_REDIS_ACL_MIN_16_CHARS

PROVIDER_QUOTA_ENABLED=true
PROVIDER_QUOTA_CONFIG_PATH=/app/core/brevio/config/provider_quotas.example.yaml

ENVIRONMENT=production
API_KEY=CHANGE_ME_API_KEY_MIN_24_CHARS
SECRET_TOKEN_KEY=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
# 32 bytes AES-256 en Base64 URL-safe (obligatorio en production).
CREDENTIAL_ENCRYPTION_KEY=
# Opcional: clave anterior para rotación (solo decrypt).
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Detrás de nginx /api/: Path de la cookie refresh visto por el navegador.
REFRESH_COOKIE_PATH=/api/auth

CORS_ORIGINS=https://brevio.darelhomelab.duckdns.org
TRUSTED_PROXY=172.28.0.0/16
BREVIO_API_URL=https://brevio.darelhomelab.duckdns.org/api
VITE_API_URL=/api

MAX_TOKENS=4096
MAX_TOKEN_PER_MINUTE=200000
TEMPERATURE=0.2
MAX_TOKEN_WAIT=300
BREVIO_KEEP_PARTIALS=false
DEV_ALLOW_PLATFORM_OVERRIDE=false

OPENAI_API_KEY=
OPENAI_API_URL=http://host.docker.internal:8080/v1
GOOGLE_API_KEY=
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
OLLAMA_API_URL=http://host.docker.internal:11434/v1
RUNAI_API_URL=http://host.docker.internal:11435/v1

EMAIL_FROM=
EMAIL_PASSWORD=

AUTH_RATE_LIMIT=50
AUTH_RATE_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT=180
AUTH_REFRESH_RATE_WINDOW_SECONDS=60
IP_GLOBAL_RATE_LIMIT=300
IP_GLOBAL_RATE_WINDOW_SECONDS=60
# Nginx (frontend/nginx.conf) acepta hasta 10g. Alinear techo de app:
MAX_UPLOAD_BYTES=10737418240
MAX_UPLOAD_FILES=10
MAX_TOTAL_UPLOAD_BYTES=10737418240

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUALLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUALLY=

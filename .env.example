# =============================================================================
# BrevioAI — variables de entorno (raíz)
# Copiar a `.env`. Catálogo completo: docs/ENVIRONMENT.md
#
# Este archivo lo usan:
#   - docker compose (interpolación de puertos + env_file de backend/celery/database)
#   - la API y Celery dentro de los contenedores
#   - benchmarks/scripts que hacen load_dotenv() de la raíz
#
# NO lo usa Vite. El frontend tiene su propio archivo: frontend/.env.example
# =============================================================================

# -----------------------------------------
# Docker / proceso Python
# -----------------------------------------
PYTHONUNBUFFERED=1
PYTHONPATH=/app
LOG_LEVEL=DEBUG

FRONTEND_PORT=80
FRONTEND_DEV_PORT=3000
BACKEND_PORT=8000
MONGO_PORT=27017
# Host 6380 → contenedor Redis 6379 (Celery DB 0, cuotas DB 2).
REDIS_PORT=6380

# -----------------------------------------
# MongoDB
# MONGO_INITDB_* solo aplican la primera vez que se crea el volumen db_data.
# -----------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=brevio
MONGODB_URI=mongodb://root:password@database:27017/brevio?authSource=admin
# SERVER_SELECTION_TIMEOUT_MS=30000
# CONNECT_TIMEOUT_MS=20000
# SOCKET_TIMEOUT_MS=60000

# -----------------------------------------
# Redis / Celery / SSE
# -----------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Si se omite, los eventos SSE reutilizan CELERY_BROKER_URL cuando es redis://.
# EVENTS_REDIS_URL=redis://redis:6379/0
# EVENTS_SSE_HEARTBEAT_SECONDS=15

# -----------------------------------------
# Seguridad y autenticación
# Nombres canónicos: SECRET_TOKEN_KEY, TOKEN_ALGORITHM.
# Alias legado (solo si el canónico está vacío): SECRET_KEY, ALGORITHM.
# -----------------------------------------
ENVIRONMENT=development
API_KEY=local_api_key_123
SECRET_TOKEN_KEY=local_secret_key_123
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://localhost:80,http://127.0.0.1
# Obligatorio en ENVIRONMENT=production (32 bytes AES-256 en Base64 URL-safe).
# CREDENTIAL_ENCRYPTION_KEY=
# En development: permite key de plataforma si el usuario no tiene BYOK. En production siempre false.
# DEV_ALLOW_PLATFORM_OVERRIDE=true

# -----------------------------------------
# Pipeline de resumen (LLM)
# MAX_TOKEN_PER_MINUTE = token bucket LOCAL al proceso. No es el TPM de Google.
# Alias legado: TOKENS_PER_MINUTE (ignorado si MAX_TOKEN_PER_MINUTE está definido).
# El tamaño de chunk NO se configura aquí: ModelCapabilities.max_tokens_per_chunk.
# Temperatura y máximo de tokens de salida son oficiales por modelo
# (core/shared/utils/model_capabilities.py). El usuario no los configura.
# -----------------------------------------
MAX_TOKENS=4096
MAX_TOKEN_PER_MINUTE=200000
MAX_TOKEN_WAIT=300
BREVIO_KEEP_PARTIALS=false
# FORMAT es opt-in (apagado por defecto).
# BREVIO_ENABLE_FORMAT_PHASE=false
# BREVIO_MIN_TOKENS_FOR_POSTPROCESS=2000
# BREVIO_ALLOW_MAP_ORIGINAL_TEXT_FALLBACK=false
# JOB_MAX_PROVIDER_REQUESTS=120

# -----------------------------------------
# Cuotas distribuidas de proveedor (Redis)
# Fail-closed si enabled=true y falta YAML o Redis.
# -----------------------------------------
PROVIDER_QUOTA_ENABLED=true
PROVIDER_QUOTA_CONFIG_PATH=/app/core/brevio/config/provider_quotas.example.yaml
PROVIDER_QUOTA_REDIS_URL=redis://redis:6379/2

# -----------------------------------------
# Transcripción
# -----------------------------------------
# WHISPER_LOCAL_USER_ACCESS=true
# ENABLED_TRANSCRIPTION_PROVIDERS=openai,google,xai,local_whisper
# TRANSCRIPTION_DEFAULT_PROVIDER=local_whisper
WHISPER_LOCAL_MODEL=small
WHISPER_LOCAL_TIMEOUT=600
FFMPEG_TIMEOUT=300
OPENAI_TRANSCRIPTION_TIMEOUT=120
# OPENAI_TRANSCRIPTION_API_URL=https://api.openai.com/v1
# GOOGLE_TRANSCRIPTION_TIMEOUT=180
# XAI_TRANSCRIPTION_TIMEOUT=180

# -----------------------------------------
# Proveedores de resumen
# Keys: {PROVIDER}_API_KEY  URLs: {PROVIDER}_API_URL
# Ollama no usa API key de plataforma; OLLAMA_API_URL es el servidor.
# -----------------------------------------
# SUMMARY_LOCAL_USER_ACCESS=true
# ENABLED_SUMMARY_PROVIDERS=openai,deepseek,google,xai,anthropic,ollama

OPENAI_API_KEY=local-key
OPENAI_API_URL=http://host.docker.internal:8080/v1

DEEPSEEK_API_KEY=TU_DEEPSEEK_API_KEY_AQUI
DEEPSEEK_API_URL=https://api.deepseek.com

GOOGLE_API_KEY=
# GEMINI_API_KEY=  # alias oficial de plataforma para Google AI Studio / Gemini
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/

XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1

ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com

OLLAMA_API_URL=http://host.docker.internal:11434/v1

# -----------------------------------------
# Correo (solo Gmail smtp.gmail.com:587)
# Sin estas variables EmailService falla al construirse y el registro también.
# -----------------------------------------
EMAIL_FROM=TU_EMAIL_AQUI
EMAIL_PASSWORD=TU_PASSWORD_AQUI

# -----------------------------------------
# Precios / créditos de plataforma (defaults en código si se omiten)
# -----------------------------------------
# PRICING_EFFECTIVE_FROM=2026-09-09
# PRICING_VERSION=2026-09-09
# PLATFORM_CURRENCY=EUR
# USD_TO_PLATFORM_RATE=0.92
# COMMERCIAL_MARGIN=0.18
# CREDIT_UNIT_VALUE=0.01
# MINIMUM_CREDITS=1

# -----------------------------------------
# Benchmarks (Compose NO crea este usuario)
# -----------------------------------------
# BREVIO_API_URL=http://localhost:8000
BREVIO_BENCHMARK_IDENTITY=Darelsm2
BREVIO_BENCHMARK_PASSWORD=A123@test
# BREVIO_BENCHMARK_DOCS_DIR=/home/psych/Descargas/libros
# BREVIO_BENCHMARK_OUTPUT=benchmark
# BREVIO_LOGS_JSON=core/brevio_api/logs/logs.json
# BREVIO_AUDIT_DIR=

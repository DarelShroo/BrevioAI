# ==========================================
# DOCKER BUILD & PYTHON CORE
# ==========================================
PYTHONUNBUFFERED=1
PYTHONPATH=/app
LOG_LEVEL=DEBUG

# PORTS
FRONTEND_PORT=80
FRONTEND_DEV_PORT=3000
BACKEND_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6380

# ==========================================
# DATABASE (MONGODB)
# ==========================================
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=brevio
MONGODB_URI=mongodb://root:password@database:27017/brevio?authSource=admin

# ==========================================
# REDIS & CELERY
# ==========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
API_KEY=local_api_key_123
SECRET_TOKEN_KEY=local_secret_key_123
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ==========================================
# LLM LIMITS & SETTINGS
# ==========================================
MAX_TOKENS=4096
MAX_TOKENS_PER_CHUNK=3000
MAX_TOKEN_PER_MINUTE=200000
TEMPERATURE=0.2
MAX_TOKEN_WAIT=300
MAX_IDLE_TIME=60

# ==========================================
# EXTERNAL APIS (LEAVE EMPTY OR PLACEHOLDER)
# ==========================================
OPENAI_API_KEY=local-key
OPENAI_API_URL=http://host.docker.internal:8080/v1

DEEPSEEK_API_KEY=TU_DEEPSEEK_API_KEY_AQUI
DEEPSEEK_API_URL=https://api.deepseek.com

# ==========================================
# EMAIL NOTIFICATIONS (LEAVE EMPTY OR PLACEHOLDER)
# ==========================================
EMAIL_FROM=TU_EMAIL_AQUI
EMAIL_PASSWORD=TU_PASSWORD_AQUI

# ==========================================
# FRONTEND VITE
# ==========================================
VITE_API_URL=http://localhost:8000

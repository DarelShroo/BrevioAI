FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

WORKDIR /app

# System deps + mermaid CLI first so source edits do not invalidate these layers.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3.12 \
      python3.12-venv \
      libglib2.0-0 \
      tesseract-ocr \
      tesseract-ocr-spa \
      poppler-utils \
      ffmpeg \
      nodejs \
      npm \
      libnss3 \
      libnspr4 \
      libgbm1 \
      libasound2t64 \
      libatk-bridge2.0-0 \
      libgtk-3-0 \
      libx11-xcb1 \
      libpango-1.0-0 \
      libpangoft2-1.0-0 \
      libharfbuzz0b \
      libgdk-pixbuf-2.0-0 \
      shared-mime-info \
      fontconfig \
      fonts-dejavu-core \
      fonts-noto-core \
      fonts-noto-mono \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_CACHE_DIR=/opt/puppeteer_cache
RUN mkdir -p /opt/puppeteer_cache && chmod 777 /opt/puppeteer_cache && \
    npm install -g @mermaid-js/mermaid-cli@10.9.1 --unsafe-perm=true

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Dependency layer: only invalidated when requirements change.
# openai-whisper's setup.py imports pkg_resources. Pip's isolated build env can
# pull setuptools>=82 (pkg_resources removed) and fail. Pin the build env too.
COPY requirements.dev.txt /app/core/requirements.dev.txt
RUN printf 'setuptools>=65,<81\n' > /tmp/pip-build-constraints.txt && \
    pip install --upgrade pip "setuptools==79.0.0" wheel && \
    pip install --no-cache-dir \
      --build-constraint /tmp/pip-build-constraints.txt \
      -r core/requirements.dev.txt

# Application source last (bind-mounted in docker-compose.dev.yml).
COPY . /app/core

EXPOSE 8000

CMD ["fastapi", "run", "core/brevio_api/__main__.py", "--port", "8000"]

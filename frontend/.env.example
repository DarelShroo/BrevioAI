# Vite only. Este directorio NO usa el .env de la raíz del repo.
#
# Producción (build Docker):  copiar a frontend/.env
# Desarrollo (Vite / compose.dev): copiar a frontend/.env.development
#
# VITE_* se embebe en el bundle. VITE_API_KEY es pública en el cliente:
# solo protege catálogo read-only; debe coincidir con API_KEY del backend.

# --- producción (ejemplo) ---
# VITE_API_URL=/api
# VITE_API_KEY=CHANGE_ME_SAME_AS_ROOT_API_KEY

# --- desarrollo (ejemplo) ---
VITE_API_URL=http://localhost:8000
VITE_API_KEY=local_api_key_123

# Optional. Vite build output directory (vite.config.ts reads process.env.VITE_OUT_DIR).
# VITE_OUT_DIR=dist

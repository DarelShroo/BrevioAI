# Vite only. This file is NOT the repo-root .env.
# Copy to frontend/.env
# VITE_* values are baked into the browser bundle at build/dev time.
# VITE_API_KEY must match API_KEY in the root .env (X-API-KEY on catalog GETs).

VITE_API_URL=http://localhost:8000
VITE_API_KEY=local_api_key_123

# Optional. Vite build output directory (vite.config.ts reads process.env.VITE_OUT_DIR).
# VITE_OUT_DIR=dist

{
    "info": {
        "name": "BrevioAI API Ultimate Edition",
        "description": "Exhaustive Postman Collection for BrevioAI backend API. Includes all possible enum values (Categories, Styles, Languages, Output Formats, Models), detailed parameters, authentication flows, edge cases, and mocked responses for 200, 400, 401, and 422.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "api_key",
            "value": "local_api_key_123",
            "type": "string"
        },
        {
            "key": "token",
            "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "description": "Endpoints for user registration, login, and password recovery.",
            "item": [
                {
                    "name": "Login User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"johndoe\",\n    \"password\": \"SecurePassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Authenticates a user and returns a JWT access token.\n\n**Possible Errors:**\n- `401 Unauthorized`: Invalid credentials.\n- `422 Unprocessable Entity`: Validation error (missing fields)."
                    },
                    "response": [
                        {
                            "name": "200 OK - Success",
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n    \"status\": \"success\",\n    \"data\": {\n        \"access_token\": \"eyJhb...\",\n        \"token_type\": \"bearer\",\n        \"user\": {\n            \"id\": \"507f1f77bcf86cd799439011\",\n            \"username\": \"johndoe\",\n            \"email\": \"johndoe@example.com\"\n        }\n    }\n}"
                        },
                        {
                            "name": "401 Unauthorized",
                            "status": "Unauthorized",
                            "code": 401,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n    \"detail\": \"Invalid credentials\"\n}"
                        }
                    ]
                },
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"newuser99\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"StrongPassword!9\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Registers a new user in the system.\n\n**Possible Errors:**\n- `400 Bad Request`: User already exists.\n- `422 Unprocessable Entity`: Invalid email format or missing fields."
                    },
                    "response": [
                        {
                            "name": "201 Created - Success",
                            "status": "Created",
                            "code": 201,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n    \"status\": \"success\",\n    \"data\": {\n        \"user_id\": \"507f1f77bcf86cd799439011\",\n        \"message\": \"User registered successfully\"\n    }\n}"
                        }
                    ]
                },
                {
                    "name": "Password Recovery Handshake",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@example.com\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/password-recovery-handshake",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password-recovery-handshake"
                            ]
                        },
                        "description": "Initiates the password recovery flow by sending an OTP to the user's email."
                    }
                },
                {
                    "name": "Password Recovery Verify",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@example.com\",\n    \"otp\": \"123456\",\n    \"new_password\": \"NewSecurePassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/password-recovery-verify",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password-recovery-verify"
                            ]
                        },
                        "description": "Verifies the OTP and updates the user's password."
                    }
                }
            ]
        },
        {
            "name": "Users",
            "description": "Endpoints to manage user-specific data like folders and entries. Requires JWT Authorization.",
            "item": [
                {
                    "name": "Get User Entries",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "description": "JWT Access Token"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"entries_refs\": [\n        \"507f1f77bcf86cd799439011\",\n        \"607f1f77bcf86cd799439012\"\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/users/entries",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "users",
                                "entries"
                            ]
                        },
                        "description": "Retrieves user entries (histories, files, summaries) by their MongoDB ObjectIds.\n\n**Possible Errors:**\n- `400`: Invalid ObjectId format.\n- `401`: Unauthorized (missing/invalid token).\n- `403`: Forbidden (user tries to access entries belonging to someone else).\n- `404`: No entries found."
                    },
                    "response": [
                        {
                            "name": "200 OK - Success",
                            "status": "OK",
                            "code": 200,
                            "header": [
                                {
                                    "key": "Content-Type",
                                    "value": "application/json"
                                }
                            ],
                            "body": "{\n    \"entries\": [\n        {\n            \"_id\": \"507f1f77bcf86cd799439011\",\n            \"name\": \"Summary 1\",\n            \"type\": \"history\"\n        }\n    ]\n}"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Billing & Estimations",
            "description": "Endpoints to calculate and predict API token costs and billing limits. Requires X-API-KEY.",
            "item": [
                {
                    "name": "Estimate Media Cost",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "{{api_key}}",
                                "description": "Static API Key"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/billing/estimate-media?minutes=45.5&model=gpt-4o-mini&language=ENGLISH",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "billing",
                                "estimate-media"
                            ],
                            "query": [
                                {
                                    "key": "minutes",
                                    "value": "45.5",
                                    "description": "Duration of media in minutes (Float)"
                                },
                                {
                                    "key": "model",
                                    "value": "gpt-4o-mini",
                                    "description": "AI Model (e.g. gpt-4o, gpt-4o-mini, gpt-4-turbo)"
                                },
                                {
                                    "key": "language",
                                    "value": "ENGLISH",
                                    "description": "Input language (e.g. ENGLISH, SPANISH)"
                                }
                            ]
                        },
                        "description": "Calculates the estimated token cost for transcribing and summarizing an audio/video file of a given duration."
                    }
                },
                {
                    "name": "Estimate Documents Cost",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "{{api_key}}",
                                "description": "Static API Key"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/billing/estimate-documents?file_tokens=15000&model=gpt-4o&language_input=SPANISH&language_output=ENGLISH&category=EDUCATION&style=guide&output_format=markdown&summary_level=detailed",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "billing",
                                "estimate-documents"
                            ],
                            "query": [
                                {
                                    "key": "file_tokens",
                                    "value": "15000",
                                    "description": "Token count from frontend tokenizer"
                                },
                                {
                                    "key": "model",
                                    "value": "gpt-4o",
                                    "description": "Model type"
                                },
                                {
                                    "key": "language_input",
                                    "value": "SPANISH",
                                    "description": "Input text language"
                                },
                                {
                                    "key": "language_output",
                                    "value": "ENGLISH",
                                    "description": "Target output language"
                                },
                                {
                                    "key": "category",
                                    "value": "EDUCATION",
                                    "description": "Category (e.g. EDUCATION, TECHNOLOGY)"
                                },
                                {
                                    "key": "style",
                                    "value": "guide",
                                    "description": "Output style (e.g. guide, report)"
                                },
                                {
                                    "key": "output_format",
                                    "value": "markdown",
                                    "description": "Output format (markdown, html, json, text)"
                                },
                                {
                                    "key": "summary_level",
                                    "value": "detailed",
                                    "description": "Summary length level (concise, detailed, etc.)"
                                }
                            ]
                        },
                        "description": "Calculates the exact token usage projection for a document summarization request based on advanced prompt combinations."
                    }
                }
            ]
        },
        {
